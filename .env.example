DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Default uses SQLite. Set DB_ENGINE=postgresql and the values below for Postgres.
DB_ENGINE=sqlite
POSTGRES_DB=dldms
POSTGRES_USER=dldms
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
